{
  "schema": 1,
  "date": "2026-11-03",
  "source": "Configured asynctest-kb MCP initialize and tools/list; no business tools called",
  "protocol": "2025-11-25",
  "input_schemas": [
    {
      "name": "add_knowledge",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "description": "稳定项目 ID；仅在项目名称唯一匹配时也接受精确名称。"
          },
          "content_mode": {
            "type": "string",
            "enum": [
              "polish",
              "preserve"
            ],
            "deprecated": true,
            "description": "仅兼容旧客户端，不再触发后端美化。请直接提交最终正文；用户要求原样时由调用方保持文字不变。"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "object",
              "properties": {
                "content": {
                  "type": "string",
                  "minLength": 1,
                  "description": "调用方准备好的最终正文。建议先整理为良好结构的 Markdown；用户要求原样则逐字保留。后端不改写。"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "description": "可选的人类可读名称，不作为知识身份。"
                },
                "content_type": {
                  "type": "string",
                  "enum": [
                    "text/markdown",
                    "text/plain"
                  ],
                  "description": "可选内容提示；省略时按 text/markdown 处理。"
                }
              },
              "required": [
                "content"
              ],
              "additionalProperties": false
            }
          },
          "interaction_response": {
            "type": "object",
            "properties": {
              "pending_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "action": {
                "type": "string",
                "enum": [
                  "apply",
                  "cancel",
                  "submit",
                  "preserve"
                ]
              },
              "input": {
                "type": "string",
                "maxLength": 20000
              }
            },
            "required": [
              "pending_id",
              "action"
            ],
            "additionalProperties": false
          }
        },
        "oneOf": [
          {
            "required": [
              "project",
              "items"
            ]
          },
          {
            "required": [
              "interaction_response"
            ]
          }
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "edit_knowledge",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "description": "稳定项目 ID；仅在项目名称唯一匹配时也接受精确名称。"
          },
          "content_mode": {
            "type": "string",
            "enum": [
              "polish",
              "preserve"
            ],
            "deprecated": true,
            "description": "仅兼容旧客户端，不再触发后端美化。请直接提交最终正文；用户要求原样时由调用方保持文字不变。"
          },
          "changes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "properties": {
                "target": {
                  "type": "object",
                  "properties": {
                    "knowledge_ref": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "description": "优先原样使用检索、盘点或读取结果返回的不透明知识引用。"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300,
                      "description": "尚无 knowledge_ref 时使用的现行知识名称。"
                    },
                    "section_path": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 16,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      },
                      "description": "可选的完整内容章节路径。"
                    }
                  },
                  "anyOf": [
                    {
                      "required": [
                        "knowledge_ref"
                      ]
                    },
                    {
                      "required": [
                        "label"
                      ]
                    }
                  ],
                  "additionalProperties": false
                },
                "before_text": {
                  "type": "string",
                  "minLength": 1
                },
                "new_content": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "target",
                "before_text",
                "new_content"
              ],
              "additionalProperties": false
            }
          },
          "replacement": {
            "type": "object",
            "properties": {
              "target": {
                "type": "object",
                "properties": {
                  "knowledge_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "description": "优先原样使用检索、盘点或读取结果返回的不透明知识引用。"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300,
                    "description": "尚无 knowledge_ref 时使用的现行知识名称。"
                  },
                  "section_path": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 16,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "description": "可选的完整内容章节路径。"
                  }
                },
                "anyOf": [
                  {
                    "required": [
                      "knowledge_ref"
                    ]
                  },
                  {
                    "required": [
                      "label"
                    ]
                  }
                ],
                "additionalProperties": false
              },
              "content": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "target",
              "content"
            ],
            "additionalProperties": false
          },
          "interaction_response": {
            "type": "object",
            "properties": {
              "pending_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "action": {
                "type": "string",
                "enum": [
                  "apply",
                  "cancel",
                  "submit",
                  "preserve"
                ]
              },
              "input": {
                "type": "string",
                "maxLength": 20000
              }
            },
            "required": [
              "pending_id",
              "action"
            ],
            "additionalProperties": false
          }
        },
        "oneOf": [
          {
            "allOf": [
              {
                "required": [
                  "project"
                ]
              },
              {
                "oneOf": [
                  {
                    "required": [
                      "changes"
                    ]
                  },
                  {
                    "required": [
                      "replacement"
                    ]
                  }
                ]
              }
            ]
          },
          {
            "required": [
              "interaction_response"
            ]
          }
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "delete_knowledge",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "description": "稳定项目 ID；仅在项目名称唯一匹配时也接受精确名称。"
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "properties": {
                "knowledge_ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "description": "优先原样使用检索、盘点或读取结果返回的不透明知识引用。"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300,
                  "description": "尚无 knowledge_ref 时使用的现行知识名称。"
                },
                "section_path": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "description": "可选的完整内容章节路径。"
                }
              },
              "anyOf": [
                {
                  "required": [
                    "knowledge_ref"
                  ]
                },
                {
                  "required": [
                    "label"
                  ]
                }
              ],
              "additionalProperties": false
            }
          },
          "interaction_response": {
            "type": "object",
            "properties": {
              "pending_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "action": {
                "type": "string",
                "enum": [
                  "apply",
                  "cancel",
                  "submit",
                  "preserve"
                ]
              },
              "input": {
                "type": "string",
                "maxLength": 20000
              }
            },
            "required": [
              "pending_id",
              "action"
            ],
            "additionalProperties": false
          }
        },
        "oneOf": [
          {
            "required": [
              "project",
              "targets"
            ]
          },
          {
            "required": [
              "interaction_response"
            ]
          }
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_knowledge_changes",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "description": "稳定项目 ID；仅在项目名称唯一匹配时也接受精确名称。"
          },
          "cursor": {
            "type": "string",
            "maxLength": 4096
          },
          "operation": {
            "type": "string",
            "enum": [
              "insert",
              "update",
              "delete",
              "move"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          }
        },
        "required": [],
        "additionalProperties": false
      }
    }
  ],
  "confirmation_roundtrip_tested": false
}
